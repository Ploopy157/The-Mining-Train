					<string name="Name">LocomotiveUpgradePanel</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="LocalScript" referent="RBX1B00A5C5907C4EAEBF2485AA08B4C519">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local ReplicatedStorage =
	game:GetService("ReplicatedStorage")

local Remotes =
	ReplicatedStorage:WaitForChild(
		"LocomotiveUpgradeRemotes"
	)

local GetData =
	Remotes:WaitForChild(
		"GetLocomotiveUpgradeData"
	)

local Purchase =
	Remotes:WaitForChild(
		"PurchaseNextLocomotive"
	)

local Refresh =
	Remotes:WaitForChild(
		"RefreshLocomotiveShop"
	)

local Panel = script.Parent
local NameLabel =
	Panel:WaitForChild("NameLabel")

local Description =
	Panel:WaitForChild("Description")

local StatsLabel =
	Panel:WaitForChild("StatsLabel")

local BuyButton =
	Panel:WaitForChild("BuyButton")

local RequestInProgress = false
local CurrentData = nil

local function FormatNumber(Number)
	local Text = tostring(
		math.floor(Number)
	)

	local Replacements

	repeat
		Text, Replacements =
			string.gsub(
				Text,
				"^(-?%d+)(%d%d%d)",
				"%1,%2"
			)
	until Replacements == 0

	return Text
end

local function RefreshPanel()
	local Success, Data = pcall(function()
		return GetData:InvokeServer()
	end)

	if not Success or not Data then
		NameLabel.Text =
			"Locomotive Upgrade"

		Description.Text =
			"Unable to load locomotive data."

		BuyButton.Text = "UNAVAILABLE"
		BuyButton.Active = false
		return
	end

	CurrentData = Data

	local Current = Data.Current
	local Next = Data.Next

	if Data.IsMaximumTier then
		NameLabel.Text =
			Current.DisplayName

		Description.Text =
			"Highest locomotive tier owned."

		StatsLabel.Text = string.format(
			"%d cars  |  Speed %d",
			Current.MaximumCars,
			Current.MaximumSpeed
		)

		BuyButton.Text =
			"MAXIMUM\nTIER"

		BuyButton.BackgroundColor3 =
			Color3.fromRGB(79, 83, 94)

		BuyButton.Active = false
		return
	end

	NameLabel.Text = string.format(
		"%s → %s",
		Current.DisplayName,
		Next.DisplayName
	)

	Description.Text = Next.Description

	StatsLabel.Text = string.format(
		"Speed %d → %d",
		tonumber(Current.MaximumSpeed) or 0,
		tonumber(Next.MaximumSpeed) or 0
	)

	BuyButton.Text = string.format(
		"BUY %s\n$%s",
		Next.DisplayName:upper(),
		FormatNumber(
			Next.PurchaseCost
		)
	)

	BuyButton.BackgroundColor3 =
		Data.CanAfford
		and Color3.fromRGB(53, 128, 76)
		or Color3.fromRGB(128, 66, 58)

	BuyButton.Active = true
end

BuyButton.Activated:Connect(function()
	if RequestInProgress
		or not CurrentData
		or CurrentData.IsMaximumTier then

		return
	end

	RequestInProgress = true
	BuyButton.Active = false

	local RequestSuccess,
		Purchased,
		Result =
		pcall(function()
			return Purchase:InvokeServer()
		end)

	RequestInProgress = false

	if not RequestSuccess then
		Description.Text =
			"Purchase request failed."

		RefreshPanel()
		return
	end

	if not Purchased then
		Description.Text =
			tostring(
				Result
				or "Purchase failed."
			)

		RefreshPanel()
		return
	end

	Description.Text = string.format(
		"Purchased %s.",
		Result.DisplayName
	)

	RefreshPanel()
end)

Refresh.OnClientEvent:Connect(
	RefreshPanel
)

RefreshPanel()
]]></ProtectedString>

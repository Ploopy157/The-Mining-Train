# Normalize text files and keep LF line endings
* text=auto eol=lf

# Explicit project text formats
*.lua text eol=lf
*.luau text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files — never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.rbxl binary
*.rbxm binary